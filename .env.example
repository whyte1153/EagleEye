# Copy to .env and edit.  NEVER commit the real .env file.
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
EAGLEEYE_SECRET_KEY=change-me
EAGLEEYE_DEBUG=True
EAGLEEYE_ALLOWED_HOSTS=127.0.0.1,localhost
# Used for HTTPS deployments, e.g. https://eagleeye.example.org
EAGLEEYE_CSRF_TRUSTED_ORIGINS=
# SQLite is the default. For PostgreSQL set EAGLEEYE_DB_ENGINE=postgresql and fill the rest.
EAGLEEYE_DB_ENGINE=sqlite
EAGLEEYE_DB_NAME=eagleeye
EAGLEEYE_DB_USER=
EAGLEEYE_DB_PASSWORD=
EAGLEEYE_DB_HOST=127.0.0.1
EAGLEEYE_DB_PORT=5432
# Failed-login throttle
EAGLEEYE_LOGIN_MAX_ATTEMPTS=5
EAGLEEYE_LOGIN_LOCKOUT_SECONDS=300
# --- Scanner (Phase 2) ---
# Scan targets are entered on the Scanner web page (no allowlist to maintain here).
# Local lab testing: loopback/private targets are refused UNLESS lab mode is on AND the target is listed here.
# Cloud-metadata addresses are never allowed, even in lab mode.
EAGLEEYE_LAB_MODE=False
EAGLEEYE_LAB_TARGETS=127.0.0.1:8001
EAGLEEYE_SCAN_ALLOWED_PORTS=80,443,8080,8443
EAGLEEYE_SCAN_RATE_LIMIT=10
EAGLEEYE_SCAN_MAX_CONCURRENT=3
EAGLEEYE_SCAN_TIMEOUT_SECONDS=8
EAGLEEYE_SCAN_DEADLINE_SECONDS=30
EAGLEEYE_SCAN_MAX_BODY_BYTES=262144

# --- Evidence (Phase 3) ---
# Where evidence files are stored. Must NOT be inside static/ or any web-served folder.
# Default: ./evidence_store (git-ignored).  Use a dedicated, backed-up, access-restricted location in production.
EAGLEEYE_EVIDENCE_ROOT=
EAGLEEYE_EVIDENCE_MAX_MB=100

# --- Network analysis (Phase 4) ---
# Limits for imported Nmap XML / PCAP files. Files are parsed, never executed.
EAGLEEYE_NETWORK_MAX_MB=100
EAGLEEYE_NETWORK_MAX_HOSTS=5000
EAGLEEYE_NETWORK_MAX_PACKETS=500000
EAGLEEYE_NETWORK_DEADLINE_SECONDS=60
